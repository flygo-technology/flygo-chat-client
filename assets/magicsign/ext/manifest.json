{
  "manifest_version": 3,
  "name": "Ký số đa năng – Ký từ xa",
  "version": "0.7.5",
  "description": "Chuyển yêu cầu ký số của website tới máy chủ Ký số đa năng thay cho plugin cài trên máy.",
  "permissions": [
    "storage",
    "identity",
    "webRequest",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_origin_as_fallback": true
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "prompt.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "inject.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_origin_as_fallback": true,
      "world": "MAIN"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Ký số đa năng"
  },
  "options_page": "options.html",
  "icons": {
    "128": "icon.png"
  },
  "storage": {
    "managed_schema": "managed_schema.json"
  }
}
